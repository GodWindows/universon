# Copie ce fichier en .env et remplis les valeurs.

# Adresse publique du site, sans / final. Le retour Google sera ${SITE_URL}/api/auth/google/callback
SITE_URL=http://localhost:8080
HTTP_PORT=8080
PMA_PORT=8081

# Google OAuth (console.cloud.google.com > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base MySQL (conteneur « db »)
DB_NAME=universon
DB_USER=universon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
